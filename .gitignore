# --- Workspace: cloned child repos live here, each tracks its own git ---
/repos/*
!/repos/.gitkeep

# --- Workspace lockfile is optional; uncomment to NOT pin child commits ---
# repos.lock

# --- Environment & secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- AI tools ---
.tmp/
.aider*
.cline*
.cursor*

# --- Logs ---
*.log
logs/
